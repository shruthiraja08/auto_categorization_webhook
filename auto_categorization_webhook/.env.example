# ============================================================
# Auto Categorization Webhook — Environment Variable Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
# ============================================================

# ----------------------------------------------------------
# OpenAI Settings (REQUIRED)
# ----------------------------------------------------------

# Your OpenAI API key. Must start with "sk-".
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model to use for classification. Options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# Timeout for OpenAI API calls in seconds (5.0 – 120.0)
OPENAI_TIMEOUT_SECONDS=30.0

# Maximum retry attempts on transient OpenAI errors (1 – 5)
OPENAI_MAX_RETRIES=3

# ----------------------------------------------------------
# Classification Settings
# ----------------------------------------------------------

# Confidence threshold below which a result is flagged as low_confidence.
# Range: 0.0 (flag everything) to 1.0 (flag nothing).
CONFIDENCE_THRESHOLD=0.75

# Relative or absolute path to the few-shot examples JSON file.
SAMPLES_PATH=samples.json

# ----------------------------------------------------------
# API Security (REQUIRED)
# ----------------------------------------------------------

# Secret key required in the X-API-Key header for all /classify requests.
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-secret-api-key-minimum-16-chars

# ----------------------------------------------------------
# Logging Settings
# ----------------------------------------------------------

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Path for the JSONL prediction audit log file.
PREDICTIONS_LOG_PATH=logs/predictions.log

# Maximum log file size before rotation (bytes). Default: 10 MB
LOG_MAX_BYTES=10485760

# Number of rotated log backups to keep.
LOG_BACKUP_COUNT=5

# ----------------------------------------------------------
# Server Settings
# ----------------------------------------------------------

# Host address for Uvicorn.
APP_HOST=0.0.0.0

# Port number for Uvicorn.
APP_PORT=8000

# Backend URL for the frontend UI.
BACKEND_URL=http://localhost:8000

# Number of Uvicorn worker processes (set to 1 during development).
APP_WORKERS=1

# Enable FastAPI debug mode. MUST be False in production.
DEBUG=False
